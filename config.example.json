{
  // Copy to C:\ProgramData\BlackBox\config.json and restart the service. All keys optional.
  "port": 8787,
  "retention_hours": 72,
  "commit_interval_ms": 2000,
  "tier2_every_s": 10,
  "process_interval_s": 2,
  "top_by_cpu": 10,
  "top_by_gpu": 5,
  "proc_threshold_pct": 5,
  "db_budget_mb": 500,
  "slow_tick_ms": 200,

  // regex on "<hardware name>/<sensor name>" or the LHM identifier -> tier (0 = don't store, 1 = 1 Hz, 2 = every tier2_every_s)
  "tier_overrides": {
    "^Nuvoton.*/Chipset$": 1,
    "/Data (Read|Written)$": 0
  },

  // "Power & cost" tab. Wall power ≈ (CPU package + GPU board + base_load_w) / psu_efficiency.
  // provider: "elprisetjustnu" (Swedish spot prices for area SE1-SE4, fetched every 30 min) or "fixed" (any country).
  // surcharge_per_kwh = grid transfer fee + energy tax + supplier markup (excl. VAT), from your bill.
  "electricity": {
    "enabled": true,
    "provider": "elprisetjustnu",
    "area": "SE3",
    "currency": "SEK",
    "surcharge_per_kwh": 0.0,
    "vat_pct": 25,
    "fixed_price_per_kwh": 2.0,
    "base_load_w": 60,
    "psu_efficiency": 0.92,
    "long_retention_days": 730
  },

  // self-update from GitHub Releases (banner + "Update now" button in the viewer)
  "update": { "enabled": true, "repo": "moorknet/Monitor", "check_hours": 6 },

  // same shape as profiles/*.json limits; wins over profiles for the same role
  "limit_overrides": [
    // { "role": "gpu.hotspot", "warn": 95, "crit": 105, "hysteresis": 2, "min_duration_s": 3, "source": "my tighter limit" }
  ]
}
